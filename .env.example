APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./tracewise-local.db
ARTIFACT_ROOT=./.tracewise-runtime
# LLM Provider selection
LLM_PROVIDER=bedrock

# AWS Bedrock settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
BEDROCK_ENABLED=true
# Newer Bedrock models (Claude Sonnet 5.5+) reject `temperature` in the Converse
# inferenceConfig. Leave false for those models; set true only for an older model
# that still accepts it.
BEDROCK_SEND_TEMPERATURE=false
# Never place AWS keys in this file. Use an AWS profile locally and task roles in AWS.
# NOTE: If AWS_BEARER_TOKEN_BEDROCK is set in your shell it overrides profile/SigV4
# credentials for Bedrock. A stale/expired bearer token must be unset (or refreshed)
# before the fresh profile credentials are used.

MOCK_RUNS_ENABLED=false
# local_subprocess runs the generated analysis.py with the venv python. If set to
# "disabled" with SANDBOX_REQUIRED=true, Stage 2 falls back to the result.json the
# live harness itself produced.
SANDBOX_BACKEND=local_subprocess
SANDBOX_REQUIRED=true
MAX_AGENT_TURNS_PER_CLAIM=30
MAX_TOOL_CALLS_PER_CLAIM=80
MAX_REPAIR_CYCLES=2
MAX_EXECUTION_SECONDS=180
MAX_OUTPUT_BYTES=1048576
VITE_API_BASE_URL=http://localhost:8000
