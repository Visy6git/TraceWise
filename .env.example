APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./tracewise-local.db
ARTIFACT_ROOT=./.tracewise-runtime
# LLM Provider selection: 'bedrock' or 'lmstudio'
LLM_PROVIDER=lmstudio

# AWS Bedrock settings
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_ENABLED=false
# Never place AWS keys in this file. Use an AWS profile locally and task roles in AWS.

# LM Studio settings (local OpenAI-compatible server)
LMSTUDIO_ENABLED=true
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL_ID=google/gemma-4-e4b
LMSTUDIO_TIMEOUT=120.0
MOCK_RUNS_ENABLED=true
SANDBOX_BACKEND=disabled
SANDBOX_REQUIRED=true
MAX_AGENT_TURNS_PER_CLAIM=30
MAX_TOOL_CALLS_PER_CLAIM=80
MAX_REPAIR_CYCLES=2
MAX_EXECUTION_SECONDS=180
MAX_OUTPUT_BYTES=1048576
VITE_API_BASE_URL=http://localhost:8000
