APP_ENV=local
AWS_REGION=us-east-1
# Set the exact Bedrock model ID or inference-profile ARN enabled in your AWS account.
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=6000
BEDROCK_TEMPERATURE=0.1
# Default false: only workbook metadata/column names are sent to Bedrock, never row samples.
BEDROCK_ENABLED=false
WORKSPACE_ROOT=./workspace
DATABASE_PATH=./workspace/workbench.sqlite3
MAX_UPLOAD_MB=150
MAX_DOCX_FILES=12
MAX_EXCEL_FILES=30
